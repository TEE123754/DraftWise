  (marketing)/          ← new public layout (no sidebar)
    page.tsx            ← landing / product home
    workflow/page.tsx
    pricing/page.tsx
    privacy/page.tsx
    terms/page.tsx
    layout.tsx          ← public nav bar only
  (workspace)/          ← new workspace layout (existing sidebar)
    dashboard/page.tsx  ← enhanced with widgets
    inbox/page.tsx      ← + Gmail fetch button
    cases/[caseId]/page.tsx
    completed/page.tsx
    review/page.tsx     ← NEW human review queue
    alerts/page.tsx     ← NEW drift / phishing alerts
    settings/
      connections/page.tsx  ← NEW Gmail connection
      privacy/page.tsx
    layout.tsx          ← existing AppShell moved here
  demo/page.tsx         ← unchanged entry, noindex
  sign-in/page.tsx      ← NEW unified sign-in page
  auth/callback/page.tsx
  not-found.tsx         ← NEW custom 404
  sitemap.ts
  robots.ts
  layout.tsx            ← root (fonts, canonical, JSON-LD)
  icon.svg              ← NEW DraftWise logo mark
  opengraph-image.png   ← NEW OG image
```

