ENVIRONMENT=development
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=shipping-originals
DATABASE_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
AI_PROVIDER=gemini
MORPHEUS_API_KEY=
MORPHEUS_BASE_URL=https://api.mor.org/api/v1
MORPHEUS_MODEL=
FREE_ONLY=true
DEMO_ENABLED=false
DEMO_DATASET_PATH=
# Demo sessions alive at once (8 h each) and started per hour. Defaults are 60 and 60.
DEMO_MAX_SESSIONS=60
DEMO_MAX_SESSIONS_PER_HOUR=60
ALLOWED_ORIGINS=http://localhost:3000
WORKER_ENABLED=true
WORKER_CONCURRENCY=1
PROVIDER_CONCURRENCY=2
MAX_UPLOAD_BYTES=20971520
MAX_PDF_PAGES=20
POLICY_VERSION=v1
PREVIEW_TTL_SECONDS=1800
ORIGINAL_RETENTION_DAYS=30
DERIVED_RETENTION_DAYS=7

# Live AI calls one workspace may make per day (demo sessions have their own smaller allowance).
AI_DAILY_BUDGET=30
# Pause in seconds between calls of a live classifier evaluation (the provider rate-limits bursts).
AI_EVAL_PAUSE_SECONDS=4

# Gmail (optional). All three are required before a mailbox can be connected.
# TOKEN_ENCRYPTION_KEY encrypts stored OAuth tokens; generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep it stable: tokens sealed with a lost key cannot be read or revoked from here.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TOKEN_ENCRYPTION_KEY=
